{
  "name": "tenantbleed",
  "version": "0.1.0",
  "description": "Prove your Supabase tenants are isolated. Creates two real tenants on your local stack, attacks across them, and shows the exact request that leaked.",
  "type": "module",
  "keywords": [
    "supabase",
    "rls",
    "row-level-security",
    "multi-tenant",
    "tenant-isolation",
    "postgres",
    "security",
    "scanner"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/KelvuHQ/tenantbleed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KelvuHQ/tenantbleed.git"
  },
  "bugs": {
    "url": "https://github.com/KelvuHQ/tenantbleed/issues"
  },
  "bin": {
    "tenantbleed": "dist/tenantbleed.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . --noEmit && node scripts/build.mjs && npm run build:ui",
    "build:engine": "tsc -p . --noEmit && node scripts/build.mjs",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "test:fixture": "node dist/tenantbleed.mjs supabase --workdir fixtures/supabase-vuln --out tenantbleed-report --fail-on none && node scripts/check-fixture.mjs tenantbleed-report.json",
    "test": "node --test dist-test/",
    "test:fixtures": "bash scripts/test-fixtures.sh",
    "check": "npm run build && npm test && npm run test:fixtures",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
